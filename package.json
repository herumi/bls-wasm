{
  "name": "bls-wasm",
  "version": "1.5.0",
  "description": "BLS signature for Node.js by WebAssembly",
  "main": "src/index.js",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm run build:bls_c.js && pnpm run build:browser",
    "build:bls_c.js": "make -C src",
    "build:browser": "cd browser && pnpm exec webpack",
    "test": "node test/test.js",
    "update-all": "pnpm update && pnpm --dir browser update"
  },
  "types": "src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herumi/bls-wasm.git"
  },
  "keywords": [
    "BLS signature",
    "WebAssembly",
    "pairing"
  ],
  "files": [
    "package.json",
    "src/index.js",
    "src/bls.js",
    "src/bls_c.js",
    "src/index.d.ts",
    "browser/bls.js",
    "browser/package.json"
  ],
  "author": "herumi <herumi@nifty.com> (https://github.com/herumi/)",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/herumi/bls-wasm/issues"
  },
  "devDependencies": {
    "webpack": "^5.110.3",
    "webpack-cli": "^6.0.1"
  },
  "homepage": "https://github.com/herumi/bls-wasm#readme"
}
